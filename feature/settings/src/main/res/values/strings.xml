    <string name="settings_share_help_title">Bring a listing in from your group</string>
    <string name="settings_share_help_subtitle">Share a forwarded post straight into Sagitta</string>
    <string name="settings_share_help_intro">Your WhatsApp or placement-cell group stays your discovery channel. When something worth tracking appears, Sagitta can keep it - without retyping anything.</string>
    <string name="settings_share_help_step_1">1. In the group, long-press the forwarded listing.</string>
    <string name="settings_share_help_step_2">2. Tap Share, then choose Sagitta.</string>
    <string name="settings_share_help_step_3">3. Sagitta searches the verified catalog for it - save and track it in one tap.</string>
    <string name="settings_share_help_footnote">The share goes to your device only. Nothing is posted anywhere.</string>
    <string name="settings_share_help_done">Got it</string>
